{
  "name": "@metacall/deploy-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for deploying and invoking functions on MetaCall FaaS.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metacall/deploy-mcp-server.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "metacall-deploy-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/test"
  ],
  "scripts": {
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run --silent lint && tsc",
    "dev": "tsc -w",
    "start": "node dist/index.js",
    "test": "npm run --silent build && mocha dist/test",
    "prepublishOnly": "npm run --silent build"
  },
  "dependencies": {
    "@metacall/protocol": "0.1.35",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "form-data": "^4.0.5",
    "validator": "^13.15.26",
    "yazl": "^3.3.1",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.3.0",
    "@types/validator": "^13.15.10",
    "@types/yazl": "^3.3.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "mocha": "^11.7.6",
    "prettier": "^3.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": false,
    "trailingComma": "none",
    "arrowParens": "avoid",
    "printWidth": 100
  }
}
